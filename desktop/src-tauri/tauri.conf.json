{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyAgent",
  "version": "0.3.5",
  "identifier": "labs.1bit.easyagent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EasyAgent",
        "url": "http://127.0.0.1:44721/",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 18 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage", "rpm"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "shortDescription": "AI agents, made easy.",
    "longDescription": "AI agents, made easy.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
