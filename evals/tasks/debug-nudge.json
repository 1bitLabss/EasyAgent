{
  "id": "debug-nudge",
  "category": "debug",
  "prompt": "There is a bug. The check fails. Create {workspace}/note.txt.",
  "mock": [
    "I'll change the note so the line is right.",
    "```shell\ncat {workspace}/note.txt\n```",
    "The cause is {workspace}/note.txt is missing from the check.\n```files\nwrite\n{workspace}/note.txt\nHELLO-EVAL\n```",
    "```files\nread\n{workspace}/note.txt\n```",
    "```shell\ncat {workspace}/note.txt\n```",
    "Fixed.",
    "Fixed."
  ],
  "criteria": [
    {
      "kind": "debug_sequence"
    },
    {
      "kind": "file_contains",
      "text": "HELLO-EVAL",
      "path": "{workspace}/note.txt"
    },
    {
      "kind": "reply_regex",
      "pattern": "Fixed"
    },
    {
      "kind": "unverified",
      "value": false
    },
    {
      "kind": "max_steps",
      "limit": 8
    }
  ]
}
