  "category": "files",
  "prompt": "Write {workspace}/box.json as JSON with a name field set to cedar.",
  "mock": [
    "```files\nwrite\n{workspace}/box.json\n{\"name\": \"cedar\"}\n\n```",
    "```files\nread\n{workspace}/box.json\n```",
    "box.json names cedar.",
    "box.json names cedar."
